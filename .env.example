# Server-only. Never prefix the service role key with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PREREGISTRATION_ENABLED=false
SITE_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=

# Azure Translator: create a real FREE F0 resource, then set both Vercel projects.
TRANSLATION_PROVIDER=azure
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_TIER=F0
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_MONTHLY_LIMIT=1900000
# Default global Microsoft endpoint is used unless explicitly overridden.
AZURE_TRANSLATOR_ENDPOINT=
# Optional legacy self-hosted provider: TRANSLATION_PROVIDER=libretranslate
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
TRANSLATION_LANGUAGE_MAP={}
