{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(legal|terms|privacy|probabilities)/?",
      "dest": "/$1/index.html"
    },
    {
      "src": "/legal/(.+?)/?",
      "dest": "/legal/$1/index.html"
    },
    {
      "src": "/support/?",
      "dest": "/support.html"
    },
    {
      "src": "/api/.*",
      "status": 404
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
